EIGI_API_BASE_URL=https://api.eigi.ai
EIGI_PUBLIC_API_KEY=
PI_DEVICE_SESSION_PAYLOAD=config/session_payload.json

# Optional PortAudio device selectors. Use a numeric PortAudio index or a
# case-insensitive substring from the device name printed in service logs.
PI_AUDIO_INPUT_DEVICE=
PI_AUDIO_OUTPUT_DEVICE=

# Set this if the Daily/Pipecat shared libraries are not installed in a system
# library path on the Raspberry Pi.
LD_LIBRARY_PATH=
