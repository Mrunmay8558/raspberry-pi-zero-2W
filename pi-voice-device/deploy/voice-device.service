[Unit]
Description=Pi Voice Device Native Daily Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pi-voice-device
EnvironmentFile=/opt/pi-voice-device/.env
ExecStart=/opt/pi-voice-device/deploy/run-voice-device.sh
Restart=always
RestartSec=5
User=__PI_DEVICE_USER__

[Install]
WantedBy=multi-user.target